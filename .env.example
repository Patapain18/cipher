# --- Binance API ---
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
TESTNET=true

# --- Trading ---
SYMBOL=BTC/USDT
TIMEFRAME=1h
TRADE_AMOUNT=0.001
LOOP_INTERVAL=60
DRY_RUN=true

# --- Stratégie SMA ---
SMA_SHORT_PERIOD=10
SMA_LONG_PERIOD=30

# --- Stratégie RSI ---
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# --- Stratégie MACD ---
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# --- Bollinger Bands ---
BB_PERIOD=20
BB_STD_DEV=2.0

# --- Score de confiance minimum (1-5) ---
MIN_CONFIDENCE=3

# --- Risk Management ---
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0
MAX_DRAWDOWN_PCT=10.0
POSITION_SIZE_PCT=5.0
TRADE_COOLDOWN=300
MAX_TRADES_PER_DAY=10

# --- Notifications Discord (optionnel) ---
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=

# --- Fichiers ---
DATA_DIR=data
LOG_DIR=logs
